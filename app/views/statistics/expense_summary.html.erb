<!-- expense summary chart -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <%= fa_icon_tag('money') %>
            花费统计总览
        </h5>
        <%= link_to fa_icon_tag('close'), root_path, :class => 'card-header-close' %>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-3 col-12">
                <%= form_tag request.path, :method => :get do %>
                    <div class="form-group">
                        <%= label_tag :year, t('dashboard.statistical_year') %>
                        <%= select_tag :year, options_for_select(@year_options, params[:year]), :class => 'form-control select2' %>
                    </div>
                    <!-- 客户公司筛选选项已移除 -->
                    <% if current_user.su? %>
                    <div class="form-group">
                        <%= label_tag :user_channel, mt(:user_channel) %>
                        <%= select_tag :user_channel_id, options_for_select(user_channel_options, params[:user_channel_id] || current_user.user_channel_id),
                                       :prompt => default_prompt, :class => 'form-control select2' %>
                    </div>
                    <% end %>
                    <div class="form-group">
                        <%= submit_tag t('action.submit'), :class => 'btn btn-submit' %>
                    </div>
                <% end %>

                <div class="card shadow-none border">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <%= t('dashboard.annual_total') %>
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div id="expense_summary_total_wrapper">
                            <table class="table table-sm card-text">
                                <thead>
                                <tr>
                                    <th class="pl-3">类别</th>
                                    <th>金额</th>
                                </tr>
                                </thead>
                                <tbody>
                                <% @annual_expense_infos.each do |info| %>
                                    <tr>
                                        <td class="pl-3"><%= info[:name] %></td>
                                        <td><%= number_to_currency(info[:value], unit: '¥') %></td>
                                    </tr>
                                <% end %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-9 col-12">
                <div id="expense_chart" style="height: 480px;">
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function(){
        let expense_chart = echarts.init(document.getElementById('expense_chart'), 'default');
        let res = <%= @result.to_json.html_safe %>;
        let expense_data = res.map(item => {
            return {
                name: item.name,
                type: 'bar',
                stack: item.stack,
                data: item.data
            }
        })

        let expense_option = {
            title: {
                text: '财务统计总览 - <%= @year %>',
                subtext: '月度统计 - <%= @currency %>'
            },
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'shadow'
                }
            },
            legend: {
                data: res.map(item => item.name)
            },
            grid: {
                left: '3%',
                right: '4%',
                bottom: '3%',
                containLabel: true
            },
            xAxis: {
                type: 'category',
                data: <%= @x_axis.to_json.html_safe %>
            },
            yAxis: {
                type: 'value'
            },
            series: expense_data
        };

        expense_chart.setOption(expense_option);
        
        // 响应窗口大小变化
        window.addEventListener('resize', function() {
            expense_chart.resize();
        });
    });
</script>

<!-- 详细数据表格 -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">
            <%= fa_icon_tag('table') %>
            财务数据明细表
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>月份</th>
                        <% @result.each do |item| %>
                            <th><%= item[:name] %></th>
                        <% end %>
                        <th>毛利率</th>
                        <th>净利率</th>
                    </tr>
                </thead>
                <tbody>
                    <% @x_axis.each_with_index do |month, index| %>
                        <tr>
                            <td><%= month %></td>
                            <% @result.each do |item| %>
                                <td><%= number_to_currency(item[:data][index], unit: '¥') %></td>
                            <% end %>
                            <% 
                               monthly_income = @result.find { |item| item[:name] == '每月总收入' }[:data][index]
                               gross_profit = @result.find { |item| item[:name] == '总毛利' }[:data][index]
                               net_profit = @result.find { |item| item[:name] == '总净利' }[:data][index]
                               gross_profit_rate = monthly_income.zero? ? 0 : (gross_profit / monthly_income * 100).round(2)
                               net_profit_rate = monthly_income.zero? ? 0 : (net_profit / monthly_income * 100).round(2)
                            %>
                            <td><%= number_to_percentage(gross_profit_rate, precision: 2) %></td>
                            <td><%= number_to_percentage(net_profit_rate, precision: 2) %></td>
                        </tr>
                    <% end %>
                </tbody>
                <tfoot>
                    <tr class="font-weight-bold">
                        <td>年度总计</td>
                        <% @result.each do |item| %>
                            <td><%= number_to_currency(@annual_expense_infos.find { |info| info[:name] == item[:name] }[:value], unit: '¥') %></td>
                        <% end %>
                        <td><%= @annual_expense_infos.find { |info| info[:name] == '毛利率' }[:value] %></td>
                        <td><%= @annual_expense_infos.find { |info| info[:name] == '净利率' }[:value] %></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>