<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <%= fa_icon_tag('edit') %>
            编辑项目信息
        </h5>
        <%= link_to fa_icon_tag('close'), finance_dashboard_statistics_path, :class => 'card-header-close' %>
    </div>
    <div class="card-body">
        <%= form_tag update_finance_project_path(@project), method: :patch do %>
            <div class="form-group">
                <label>开票金额</label>
                <%= number_field_tag 'project[invoice_amount]', @project.invoice_amount, class: 'form-control' %>
            </div>
            <div class="form-group">
                <label>项目状态</label>
                <%= select_tag 'project[status]', options_for_select(Project::STATUS.to_a.map(&:reverse), @project.status), class: 'form-control' %>
            </div>
            <div class="form-group">
                <label>预计收款时间</label>
                <%= date_field_tag 'project[invoice_payment_date]', @project.invoice_payment_date&.strftime('%Y-%m-%d'), class: 'form-control' %>
            </div>
            <div class="form-group">
                <label>备注</label>
                <%= text_area_tag 'project[project_remarks_attributes][0][remark]', @project.project_remarks.last&.remark, class: 'form-control' %>
            </div>
            <div class="form-group">
                <%= submit_tag '保存', class: 'btn btn-primary' %>
                <%= link_to '返回', finance_dashboard_statistics_path, class: 'btn btn-secondary ml-2' %>
            </div>
        <% end %>
    </div>
</div>