<% if @project.errors.any? %>
  $('.alert').remove();
  $('#flash-messages').append('<div class="alert alert-danger"><%= j(@project.errors.full_messages.join(", ")) %></div>');
<% else %>
  $('.alert').remove();
  $('#flash-messages').append('<div class="alert alert-success"><%= j(flash[:notice]) %></div>');
  
  // 先解绑之前的事件处理器
  $('#editFinanceModal').off('hidden.bs.modal');

  // 在模态框隐藏后更新数据
  $('#editFinanceModal').on('hidden.bs.modal', function() {
    var projectRow = $('#project-<%= @project.id %>');
    projectRow.find('.total-price').text('<%= number_to_currency(@project.total_price) %>');
    projectRow.find('.invoice-amount').text('<%= number_to_currency(@project.invoice_amount) %>');
    projectRow.find('.invoice-payment-date').text('<%= @project.invoice_payment_date&.strftime("%Y-%m-%d") %>');
    projectRow.find('.status').text('<%= @project.status %>');
    
    // 如果有备注信息，更新备注
    <% if @project.project_remarks.any? %>
      var latestRemark = '<%= j(@project.project_remarks.last.remark) %>';
      projectRow.find('.project-remarks').text(latestRemark);
    <% end %>
    
    // 强制刷新表格中的数据
    projectRow.find('.total-price, .invoice-amount, .invoice-payment-date, .status, .project-remarks').hide().show();
    
    // 解绑事件处理器，避免重复绑定
    $(this).off('hidden.bs.modal');
  });

  // 关闭模态框
  $('#editFinanceModal').modal('hide');
<% end %>